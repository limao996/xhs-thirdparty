<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- video playback: media3 ExoPlayer wake lock + keep-screen-on -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.XHS">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <!-- configChanges: Compose reads the configuration through
                 LocalConfiguration and re-lays out on its own, so the activity
                 does not need to be recreated for a rotation. Without this the
                 rotation rebuilds the composition (and therefore the ExoPlayer),
                 which restarts the video and forces the stream to re-buffer. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Shared-note links: xhstp://note/<noteId>.
                 A custom scheme rather than an https App Link because an App Link
                 would need assetlinks.json on a domain we do not own; this needs no
                 verification and opens the app straight on the shared note.
                 BROWSABLE + DEFAULT so it is tappable from messaging apps. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="xhstp" android:host="note" />
            </intent-filter>
        </activity>
    </application>

</manifest>