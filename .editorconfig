root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

[*.{gradle,properties}]
indent_size = 4

[*.{yml,yaml,json,xml,html,css,js}]
indent_size = 2

[*.md]
# Markdown 的行尾双空格是有意义的（换行）
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.{py,ps1}]
indent_size = 4

[Makefile]
indent_style = tab
