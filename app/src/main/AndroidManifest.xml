<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- video playback: media3 ExoPlayer wake lock + keep-screen-on -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- A personal WebDAV drive may be plain http:// on the LAN; Android
         denies cleartext by default from API 28, which would make those
         servers unreachable. API traffic itself stays HTTPS. -->
    <application
        android:usesCleartextTraffic="true"
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.XHS">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <!-- launchMode=singleTask：默认的 standard 会让「深链打开作品」新建**第二个**
                 MainActivity 实例叠在任务上，于是 onNewIntent 永远收不到（代码里原先依赖它），
                 两个实例还各自能进小窗。singleTask 保证复用同一实例并走 onNewIntent。 -->
            <!-- configChanges: Compose reads the configuration through
                 LocalConfiguration and re-lays out on its own, so the activity
                 does not need to be recreated for a rotation. Without this the
                 rotation rebuilds the composition (and therefore the ExoPlayer),
                 which restarts the video and forces the stream to re-buffer. -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share links: the 分享 action copies an `xhstp://note/<id>` token, and
                 opening such a link (browser, chat, anywhere) must come back here.
                 The MAIN/LAUNCHER filter deliberately lives on the aliases below
                 instead, so the launcher name/icon can be switched at runtime —
                 having it here too would put a second, fixed icon on the desktop. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="xhstp" android:host="note" />
            </intent-filter>
        </activity>
    </application>
</manifest>